{
  "manifest_version": 3,
  "name": "TikPoc Event Bridge",
  "version": "0.1.0",
  "description": "Relays TikTok follower events to the local TikPoc dashboard.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "exclude_matches": [
        "https://www.tiktok.com/messages*",
        "https://www.tiktok.com/business-suite/*"
      ],
      "js": ["core.js", "binding-core.js", "options-core.js", "auto-connect-core.js", "auto-connect.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/messages*",
        "https://www.tiktok.com/business-suite/messages*"
      ],
      "js": ["dm-core.js", "binding-core.js", "options-core.js", "dm-content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "TikPoc Event Bridge",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
